namespace Principia1687.LemmaX
open NewtonLimitDynamics NewtonLimitDynamics.Fraction

/-- Errors generated by equal forces, sharing the positive Lemma X coefficient
`c`, are ultimately as the squares of their times when the second body's time
is the fixed multiple `r` of the first's. The shared `c` is the supplied
reading of "viribus æqualibus ... similiter applicatis". -/
theorem corollary1_errors_as_squares_of_times (e₁ e₂ : Fraction → Fraction)
    (c r : Fraction) (hc : positive c) (hr : positive r)
    (p₁ : Principia1687.LemmaXPremises magnitudes (ratio e₁) c)
    (p₂ : Principia1687.LemmaXPremises magnitudes (ratio e₂) c) :
    QuadraticInitialDeflection magnitudes (ratio e₁) c ∧
      QuadraticInitialDeflection magnitudes (fun t => ratio e₂ (mul r t)) c :=
  ⟨⟨hc, Principia1687.lemmaX_reconstruction _ _ _ p₁⟩,
    ⟨hc, ultimate_time_scale r hr (Principia1687.lemmaX_reconstruction _ _ _ p₂)⟩⟩

end Principia1687.LemmaX

