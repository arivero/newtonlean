  "P1713.P6C3" [label="P1713.P6C3\nCurvature-chord force ratio", fillcolor="#d6ecd2", color="#8d8d8d", penwidth=1];
  "P1713.P7C3" [label="P1713.P7C3\nForce-centre comparison in same orbit\nand period", fillcolor="#d6ecd2", color="#8d8d8d", penwidth=1];
